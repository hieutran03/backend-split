{
  "name": "chatbot-backend",
  "version": "0.1.0",
  "description": "Chatbot backend (NestJS): auth, ownership, CRUD, turn orchestration, storage. AI runs in the Python AI Engine behind /internal/v1.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "pnpm test:unit && pnpm test:architecture",
    "test:unit": "jest --config config/jest/unit.config.js",
    "test:unit:watch": "jest --config config/jest/unit.config.js --watch",
    "test:integration": "jest --config config/jest/integration.config.js",
    "test:architecture": "depcruise --config .dependency-cruiser.cjs src",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:architecture && pnpm build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "node scripts/typeorm.js migration:run -d src/data-source.ts",
    "db:migrate:revert": "node scripts/typeorm.js migration:revert -d src/data-source.ts",
    "db:migrate:show": "node scripts/typeorm.js migration:show -d src/data-source.ts",
    "db:seed": "ts-node -r tsconfig-paths/register scripts/seed-dev.ts",
    "token:dev": "ts-node -r tsconfig-paths/register scripts/dev-token.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^12.1.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.3",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10"
  }
}
