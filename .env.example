NODE_ENV=development
PORT=3000
HTTP_GLOBAL_PREFIX=api/v1
CORS_ORIGINS=
# Unset/empty => enabled in development/test, disabled in production
SWAGGER_ENABLED=

DATABASE_URL=postgres://chatbot:chatbot@localhost:5432/chatbot
DATABASE_POOL_MAX=10
DATABASE_LOG_QUERIES=false

REDIS_URL=redis://localhost:6379

# Must EQUAL the Python SECRET_KEY (R25) so existing tokens keep working.
JWT_SECRET=change-me-dev-only
JWT_ACCESS_TTL_SECONDS=900
# Accept legacy access tokens without a `type` claim (D19, W1 transition).
JWT_ACCEPT_LEGACY_ACCESS=true
JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_COST=12
# D19: legacy Python refresh JWTs can be exchanged once until this instant (W1 cutover + 7 days).
# Empty => disabled. Example: 2026-12-11T00:00:00+07:00
JWT_LEGACY_REFRESH_UNTIL=
ADMIN_USER_IDS=
# Guard cache for token_version/deleted_at, max 30 (spec). 0 = no cache.
AUTH_USER_STATE_CACHE_SECONDS=30

# mock = in-process simulated AI Engine (default for development)
# http = call the real AI Engine via /internal/v1
AI_ENGINE_MODE=mock
AI_ENGINE_BASE_URL=http://localhost:8001
AI_ENGINE_SERVICE_TOKEN=dev-service-token
AI_ENGINE_TIMEOUT_MS=30000
# Delay between mock events (ms) - use 0 in tests
AI_ENGINE_MOCK_DELAY_MS=40
