NODE_ENV=development
PORT=3000
HTTP_GLOBAL_PREFIX=api/v1
CORS_ORIGINS=

DATABASE_URL=postgres://chatbot:chatbot@localhost:5432/chatbot
DATABASE_POOL_MAX=10
DATABASE_LOG_QUERIES=false

REDIS_URL=redis://localhost:6379

# Phải TRÙNG với SECRET_KEY của Python (R25) để token cũ còn dùng được.
JWT_SECRET=change-me-dev-only
JWT_ACCESS_TTL_SECONDS=900
# Chấp nhận access token cũ không có claim `type` (D19, chuyển tiếp W1).
JWT_ACCEPT_LEGACY_ACCESS=true
ADMIN_USER_IDS=

# mock = AI Engine giả lập trong tiến trình (mặc định khi dev)
# http = gọi AI Engine thật qua /internal/v1
AI_ENGINE_MODE=mock
AI_ENGINE_BASE_URL=http://localhost:8001
AI_ENGINE_SERVICE_TOKEN=dev-service-token
AI_ENGINE_TIMEOUT_MS=30000
# Độ trễ giữa các event của mock (ms) — đặt 0 khi chạy test
AI_ENGINE_MOCK_DELAY_MS=40
